resource "random_bytes" "aead_secret_key" {
  length = 32
}

resource "random_bytes" "nextauth_secret" {
  length = 32
}

resource "random_bytes" "shared_secret_token" {
  length = 32
}

resource "random_password" "clickhouse" {
  length  = 32
  special = false
}

resource "random_password" "rabbitmq" {
  length  = 32
  special = false
}

resource "random_password" "postgres" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "laminar" {
  name                    = "${var.name_prefix}/laminar"
  description             = "Laminar keys and passwords, generated by Terraform"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "laminar" {
  secret_id = aws_secretsmanager_secret.laminar.id
  secret_string = jsonencode({
    AEAD_SECRET_KEY        = random_bytes.aead_secret_key.hex
    NEXTAUTH_SECRET        = random_bytes.nextauth_secret.hex
    SHARED_SECRET_TOKEN    = random_bytes.shared_secret_token.hex
    CLICKHOUSE_PASSWORD    = random_password.clickhouse.result
    RABBITMQ_PASSWORD      = random_password.rabbitmq.result
    POSTGRES_PASSWORD      = random_password.postgres.result
    DATABASE_URL           = "postgres://lmnr:${random_password.postgres.result}@${aws_db_instance.postgres.address}:${aws_db_instance.postgres.port}/lmnr"
    DATABASE_SSL_ROOT_CERT = data.http.rds_ca_bundle.response_body
    RABBITMQ_URL           = "amqp://admin:${random_password.rabbitmq.result}@${aws_instance.data_box.private_ip}:5672/%2f"
  })
}
